{
  "x-schema": "batch/plan.schema.json",
  "$comment": "POC D (RE-native): one plan producing materials, Niagara, and a DT_Abilities row via create_spell — not Epic GAS GA/GE assets. Validated by tools/validate_schemas.py. Evidence: docs/research/RB-12-gas-and-gameplay.md.",

  "transaction": {
    "atomic": true,
    "rollback_on_failure": true,
    "compile_policy": "at_boundaries",
    "validate_policy": "at_end"
  },

  "operations": [
    {
      "id": "core_material",
      "action": "create_vfx_material",
      "mode": "create_or_update",
      "target": { "asset_path": "/Game/__UeremcpTests/VFX/Materials/MI_Fireball_Core" },
      "specification": {
        "purpose": "fireball_core",
        "features": ["radial_falloff", "animated_noise", "fresnel", "dynamic_color", "dynamic_intensity"]
      }
    },
    {
      "id": "trail_material",
      "action": "create_vfx_material",
      "mode": "create_or_update",
      "optional": true,
      "target": { "asset_path": "/Game/__UeremcpTests/VFX/Materials/MI_Fireball_Trail" },
      "specification": {
        "purpose": "fireball_ribbon_trail",
        "features": ["panning_textures", "erosion", "depth_fade", "dynamic_color"]
      }
    },
    {
      "id": "projectile_fx",
      "action": "create_niagara_effect",
      "depends_on": ["core_material", "trail_material"],
      "target": { "asset_path": "/Game/__UeremcpTests/VFX/Spells/NS_Fireball" },
      "specification": {
        "name": "Fireball",
        "effect_type": "projectile",
        "components": ["core", "flame_shell", "sparks", "smoke", "ribbon_trail"],
        "core_material": { "$ref": "core_material.result.primary_asset" },
        "trail_material": { "$ref": "trail_material.result.primary_asset" },
        "parameters": {
          "primary_color": [1.0, 0.12, 0.01, 1.0],
          "secondary_color": [1.0, 0.75, 0.05, 1.0],
          "scale": 1.0,
          "intensity": 8.0
        }
      }
    },
    {
      "id": "impact_fx",
      "action": "create_niagara_effect",
      "depends_on": ["core_material"],
      "target": { "asset_path": "/Game/__UeremcpTests/VFX/Spells/NS_Fireball_Impact" },
      "specification": {
        "name": "FireballImpact",
        "effect_type": "impact",
        "components": ["impact_burst", "smoke", "ground_decal"],
        "core_material": { "$ref": "core_material.result.primary_asset" }
      }
    },
    {
      "id": "spell",
      "action": "create_spell",
      "depends_on": ["projectile_fx", "impact_fx"],
      "target": {
        "asset_path": "/Game/__UeremcpTests/Abilities/DT_Abilities_UeremcpTests"
      },
      "specification": {
        "name": "Fireball_Ueremcp",
        "row_name": "Fireball_Ueremcp",
        "element": "Fire",
        "delivery": {
          "type": "projectile",
          "speed": 2400,
          "damage_radius": 175,
          "damage": 45.0
        },
        "projectile_effect": { "$ref": "projectile_fx.result.primary_asset" },
        "impact_effect": { "$ref": "impact_fx.result.primary_asset" },
        "impact_status": "Burning",
        "networking": {
          "pattern": "B",
          "authority": "server",
          "cast_path": "AuthorityCastAbility"
        }
      }
    },
    {
      "id": "smoke_test",
      "action": "validate_system",
      "depends_on": ["spell"],
      "condition": {
        "operation_status": {
          "id": "spell",
          "is": ["created_and_validated", "modified_and_validated", "created_with_warnings"]
        }
      },
      "specification": {
        "root_asset": { "$ref": "spell.result.primary_asset" },
        "checks": ["dependencies_resolve", "row_readable", "pattern_b_checklist", "compiles"]
      }
    }
  ],

  "on_failure": "rollback_all"
}
