{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uneremcp.dev/schemas/domains/environment/build_environment.schema.json",
  "title": "UEREMCP build_environment specification",
  "description": "Goal-level seeded environment build (BACKLOG Tier 4–5). Extends specification only (ADR-0003). Subsystems are opt-in: set include.* true for each stage to build. Omitting include builds a level shell only (metadata). Rain is rain-only when include.rain is true and other includes are false or absent. Snow is not implemented; weather.type enum is future work (see docs/proposals/ws-16-weather-type-enum.md).",
  "type": "object",
  "required": ["seed"],
  "additionalProperties": true,
  "properties": {
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Mandatory determinism seed (BACKLOG 5.4). Pure function of (seed, parameters)."
    },
    "destination_level_path": {
      "type": "string",
      "description": "Scratch destination under /Game/__UeremcpPoc/ or /Game/__UeremcpTests/."
    },
    "fallback_policy": {
      "type": "string",
      "enum": ["prefer_real", "allow_approximate"],
      "default": "prefer_real",
      "description": "When include.rain is true: prefer_real creates/loads real Niagara rain (or requires weather.rain_system_path). allow_approximate permits visible instanced-streak fallback when Niagara create/load fails."
    },
    "terrain": {
      "type": "object",
      "properties": {
        "size_x": { "type": "integer", "minimum": 2, "description": "Heightmap verts X; must be N*QuadsPerComponent+1" },
        "size_y": { "type": "integer", "minimum": 2 },
        "mountain_amplitude": { "type": "number", "minimum": 0 },
        "valley_depth": { "type": "number", "minimum": 0 },
        "scale_xy": { "type": "number", "minimum": 1 },
        "scale_z": { "type": "number", "minimum": 1 }
      }
    },
    "river": {
      "type": "object",
      "properties": {
        "width": { "type": "number", "minimum": 1 }
      }
    },
    "biome": {
      "type": "object",
      "properties": {
        "forest_bank_width": { "type": "number", "minimum": 1 },
        "max_foliage_instances": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "slope_limit_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 },
        "min_normalized_height": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_normalized_height": { "type": "number", "minimum": 0, "maximum": 1 },
        "mesh_path": { "type": "string", "description": "Static mesh for foliage instances" }
      }
    },
    "weather": {
      "type": "object",
      "description": "Rain-only weather today. Snow and weather.type selection are not implemented.",
      "properties": {
        "rain_system_path": {
          "type": "string",
          "description": "Optional existing UNiagaraSystem path under /Game/__UeremcpPoc/ or /Game/__UeremcpTests/. When omitted and include.rain is true, BuildEnvironment creates /.../NS_EnvRain via CreateNiagaraEffect(precipitation)."
        },
        "follow": { "type": "string", "enum": ["player_camera", "player_pawn"], "default": "player_camera" },
        "streak_count": {
          "type": "integer",
          "minimum": 32,
          "maximum": 512,
          "default": 256,
          "description": "Only used when fallback_policy=allow_approximate and Niagara create/load fails."
        }
      }
    },
    "include": {
      "type": "object",
      "description": "Opt-in subsystem flags. All default false — only stages set true are built.",
      "properties": {
        "terrain": { "type": "boolean", "default": false },
        "river": { "type": "boolean", "default": false },
        "forest": { "type": "boolean", "default": false },
        "rain": { "type": "boolean", "default": false },
        "lighting": { "type": "boolean", "default": false },
        "capture": { "type": "boolean", "default": false },
        "structures": { "type": "boolean", "default": false }
      }
    },
    "capture": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false }
      }
    }
  },
  "examples": [
    {
      "seed": 99,
      "destination_level_path": "/Game/__UeremcpPoc/RainOnly",
      "include": { "rain": true },
      "weather": { "follow": "player_camera" },
      "fallback_policy": "allow_approximate"
    },
    {
      "seed": 42,
      "destination_level_path": "/Game/__UeremcpPoc/MountainRiverRain",
      "terrain": { "mountain_amplitude": 0.55, "valley_depth": 0.12 },
      "river": { "width": 600 },
      "biome": { "forest_bank_width": 3500, "max_foliage_instances": 800 },
      "weather": { "follow": "player_camera" },
      "fallback_policy": "allow_approximate",
      "include": { "terrain": true, "river": true, "forest": true, "rain": true, "lighting": true, "capture": false }
    }
  ]
}
