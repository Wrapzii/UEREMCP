{
  "$comment": "WS-07 canonical single-call MCP request for POC B fireball (B1 transport proof). WS-11 loads this JSON and passes it to UeremcpNiagara.CreateNiagaraEffect via MCP call_tool.",
  "owner": "WS-07",
  "mcp_handoff": {
    "toolset": "UeremcpNiagara",
    "tool": "CreateNiagaraEffect",
    "request_field": "RequestJson",
    "allowed_target_roots": [
      "/Game/__UeremcpPoc/",
      "/Game/__UeremcpTests/"
    ],
    "poc_acceptance_target": "/Game/__UeremcpPoc/NS_POCB_Fireball",
    "materials_contract": "poc_b_fireball_materials.json",
    "b1_transport_assertions": [
      "metrics.mcp_round_trips == 1",
      "extra.validation.single_request_pipeline == true",
      "extra.poc_b_gates.B1_single_request_complete == true",
      "extra.poc_b_gates.never_claims includes mcp_transport_one_call (transport proof is WS-11 harness, not Niagara response)"
    ],
    "editor_parity_filter": "UEREMCP.Niagara.POCB.FireballInlineMaterials"
  },
  "request": {
    "protocol_version": "1.0",
    "request_id": "ws11-poc-b-mcp-fireball",
