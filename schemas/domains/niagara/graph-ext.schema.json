{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uneremcp.dev/schemas/domains/niagara/graph-ext.schema.json",
  "title": "Niagara graph extensions",
  "description": "Shape of graph.schema.json extensions.niagara per ADR-0004. Referenced from the shared graph schema pressure valve. Owned by WS-07.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "script_usage": {
      "type": "string",
      "enum": [
        "EmitterSpawnScript",
        "EmitterUpdateScript",
        "ParticleSpawnScript",
        "ParticleUpdateScript",
        "ParticleEventScript",
        "SystemSpawnScript",
        "SystemUpdateScript"
      ]
    },
    "emitter_name": { "type": "string" },
    "system_name": { "type": "string" },
    "stack_index": { "type": "integer", "minimum": 0 },
    "bIsSetParametersModule": { "type": "boolean" },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["mode"],
        "additionalProperties": true,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "local",
              "linked",
              "hlsl_expression",
              "data_interface",
              "dynamic_input",
              "enum",
              "unsupported"
            ]
          },
          "linked_variable": { "type": "string" },
          "dynamic_chain": { "type": "object" },
          "data_interface": { "type": "object" },
          "hlsl_expression": { "type": "string" },
          "enum_value": { "type": "string" },
          "local_value": {}
        }
      },
      "description": "Per pin_id: value mode + payload. Parameter bindings are not peer module links (RB-07)."
    },
    "renderers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["renderer_index", "renderer_class"],
        "additionalProperties": true,
        "properties": {
          "renderer_index": { "type": "integer", "minimum": 0 },
          "renderer_class": { "type": "string" },
          "property_values": { "type": "object" },
          "property_values_json": { "type": "string" },
          "material_path": { "$ref": "../../common/defs.schema.json#/$defs/assetPath" },
          "material_path_fidelity": { "type": "string" }
        }
      }
    },
    "emitter": {
      "type": "object",
      "description": "FVersionedNiagaraEmitterData fields from GetEmitterData.propertyValues.",
      "additionalProperties": true
    },
    "system": {
      "type": "object",
      "description": "System-level property blob from GetSystemData.",
      "additionalProperties": true
    },
    "sim_target": {
      "type": "string",
      "description": "CPUSim | GPUComputeSim from GetEmitterTopology / SetEmitterData."
    },
    "life_cycle": {
      "type": "object",
      "additionalProperties": true,
      "description": "Emitter State Life Cycle + Timeline. delay|start_time = Loop Delay = Timeline Start column. mode applied first (Self auto when duration/delay set).",
      "properties": {
        "mode": { "type": "string", "description": "Life Cycle Mode (Self|System)." },
        "loop_behavior": { "type": "string" },
        "loop_duration": { "type": "number" },
        "delay": { "type": "number", "description": "Loop Delay seconds (= Timeline Start)." },
        "start_time": { "type": "number", "description": "Alias for delay / Timeline Start." },
        "inactive_response": { "type": "string" },
        "loop_count": { "type": "integer" },
        "loop_duration_mode": { "type": "string" },
        "use_loop_delay": { "type": "boolean" },
        "delay_first_loop_only": { "type": "boolean" },
        "recalculate_duration_each_loop": { "type": "boolean" }
      }
    },
    "event_handlers": {
      "type": "array",
      "description": "From FVersionedNiagaraEmitterData::GetEventHandlers (+ NodeGraph samples). WRITE blocked (no UsageId on StackItemReference).",
      "items": {
        "type": "object",
        "properties": {
          "event_name": { "type": "string" },
          "source_emitter": { "type": "string" },
          "usage_guid": { "type": "string" },
          "execution_mode": { "type": "string" },
          "script_graph_internals": { "type": "object", "additionalProperties": true },
          "modules": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": true
      }
    },
    "script_graph_internals": {
      "type": "object",
      "additionalProperties": true,
      "description": "READ-only UNiagaraScriptSource::NodeGraph summary. write_supported=false."
    },
    "inheritance": {
      "type": "object",
      "properties": {
        "parent_emitter_path": { "$ref": "../../common/defs.schema.json#/$defs/assetPath" },
        "bIsInheritable": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "user_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "default_value": {}
        },
        "additionalProperties": false
      }
    },
    "compile": {
      "type": "object",
      "properties": {
        "aggregate_status": { "type": "string" },
        "bIsCompiling": { "type": "boolean" },
        "bHasErrors": { "type": "boolean" },
        "per_script": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "script_usage": "ParticleUpdateScript",
      "emitter_name": "Sparks1",
      "inputs": {
        "Scale Alpha": {
          "mode": "dynamic_input",
          "dynamic_chain": { "script": "/Niagara/DynamicInputs/UniformRange/Float" }
        }
      }
    }
  ]
}
