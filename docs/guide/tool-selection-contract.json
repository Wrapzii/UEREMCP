  "special_routes": [
    {
      "id": "execute_plan",
      "agent_facing_aicallable": true,
      "select": "Prefer InstantiateTemplate or domain goal tools for most agent goals. ExecutePlan is registered AICallable for multi-step plans but is not the first-choice agent surface (ADR-0008).",
      "catalog_status": "partial"
    },
    {
      "id": "templates_vs_domain",
      "select": "Known pattern \u2192 search_templates then instantiate_template. Novel one-off effect \u2192 create_niagara_effect / create_vfx_material / submit_graph directly."
    },
    {
      "id": "read_then_submit_graph",
      "select": "Blueprint modify: ReadGraph (complete) \u2192 edit JSON \u2192 SubmitGraph with expected_revision. Never pin-by-pin BlueprintTools loops."
    },
    {
      "id": "jobs",
      "select": "timeout_ms>0 and partially_completed with job \u2192 GetJobResult. Stop work \u2192 CancelJob (not MCP notifications/cancelled alone)."
    },
    {
      "id": "visual_capture",
      "select": "Niagara \u2192 CaptureEffectFrames; world after BuildEnvironment \u2192 CaptureWorldFrames; material \u2192 CaptureMaterialFrames; AnimSequence \u2192 CaptureAnimationFrames. Screenshots never replace structural validation."
    }
  ],
  "epic_policy": {
    "prefer_ueremcp_when": [
      "Creating or modifying Blueprint graphs with revision/hash/validation",
      "Creating Niagara effects / VFX materials as one semantic outcome",
      "Template search/instantiate",
      "Job poll/cancel for UEREMCP long ops",
      "Visual frame capture with numeric baseline deltas",
      "Building seeded landscape/river/forest/rain environments",
      "Creating SoundCues with optional attenuation",
      "Auditing Blueprint replication / Pattern B in one call",
      "Inspecting or dry-run repairing World Partition"
    ],
    "use_epic_when": [
      "Read-only asset/browser/search discovery with no UEREMCP action",
      "Domain gaps still planned/research in CAPABILITY_CATALOG",
      "One-off editor utilities outside UEREMCP domains"
    ],
    "do_not": [
      "Use BlueprintTools create_node/connect_pins loops when SubmitGraph covers the goal",
      "Use NiagaraToolsets module primitives when CreateNiagaraEffect covers the goal",
      "Use MaterialTools expression primitives when CreateVfxMaterial covers the goal",
      "Hide all Epic read-only tools globally via SetNameFilters",
      "Use BlueprintTools get/set_variable_replication loops when ValidateReplication covers the goal",
      "Use Landscape/Water/foliage primitive chains when BuildEnvironment covers the goal",
      "Author MetaSound graphs claiming create_audio_cue covers them"
    ]
  },
  "set_name_filters": {
    "api": "UE::ToolsetRegistry::FToolset::SetNameFilters(BlockPatterns, AllowPatterns)",
    "verified": "[VERIFIED: Engine/Plugins/Experimental/ToolsetRegistry/Source/ToolsetRegistry/Public/ToolsetRegistry/Toolset.h:59-60]",
    "verified_impl": "[VERIFIED: .../Private/ToolsetRegistry/Toolset.cpp:59-79]",
    "adr": "ADR-0002 \u2014 hide internal primitives from agents",
    "ueremcp_calls_today": false,
    "authorized_scope": "Hide UEREMCP-internal or Epic mutation primitives that semantic tools compose \u2014 never globally disable useful Epic read-only discovery.",
    "apply_now": false,
    "reason_not_applied": "No UEREMCP module currently calls SetNameFilters; selective Epic mutation hiding needs WS-03/settings coordination and must not retarget live RE deploy. Documented + proposed only."
  },
