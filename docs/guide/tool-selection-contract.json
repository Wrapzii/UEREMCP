{
  "contract_id": "ueremcp-tool-selection",
  "contract_version": "1.0.0",
  "as_of": "2026-07-30",
  "owner": "WS-13",
  "authority": [
    "docs/WHY.md",
    "docs/adr/ADR-0002-host-model.md",
    "docs/adr/ADR-0003-envelope.md",
    "docs/adr/ADR-0004-graph-representation.md",
    "docs/adr/ADR-0006-idempotency.md",
    "docs/adr/ADR-0008-templates.md",
    "docs/adr/ADR-0009-long-running-jobs.md",
    "docs/CAPABILITY_CATALOG.md",
    "AGENTS.md rule 5"
  ],
  "limitations": [
    "This contract makes UEREMCP the documented preferred path; it cannot guarantee arbitrary LLM tool choice.",
    "Live describe_toolset text still comes from C++ UFUNCTION comments owned by domain workstreams \u2014 see docs/proposals/ws-13-tool-selection-discoverability-2026-07-30.md.",
    "capture_effect_frames is catalog-registered and live-verified; cold renderer may require one ADR-0009 get_job_result poll.",
    "ExecutePlan is AICallable on UeremcpReferenceToolset but is not the preferred first-choice agent surface \u2014 prefer InstantiateTemplate or domain tools.",
    "Environment/Systems/general capture registration is static-complete on this tip; live registry dump + ResolveIntent proof still required after deploy."
  ],
  "principles": [
    {
      "id": "prefer_ueremcp_semantic",
      "text": "Prefer UEREMCP goal-level semantic operations for create/modify/validate workflows over Epic or REAgentTools primitive chains."
    },
    {
      "id": "epic_readonly_or_gap",
      "text": "Use Epic tools for read-only discovery, or for gaps where no UEREMCP semantic action exists yet (catalog status planned/research)."
    },
    {
      "id": "no_inspect_mutate_loop",
      "text": "Avoid primitive inspect\u2192mutate\u2192inspect loops. One complete-state call beats many pin/node calls (docs/WHY.md)."
    },
    {
      "id": "honest_status",
      "text": "Success requires re-read/validation evidence. Never treat tool-call completion or partially_completed as *_validated."
    },
    {
      "id": "no_force_claim",
      "text": "Do not claim agents can be forced. Prioritization comes from accurate names, descriptions, schemas, examples, and this routing table."
    }
  ],
  "discovery": {
    "runtime": [
      "GetStarted",
      "ResolveIntent",
      "DescribeOperation",
      "list_toolsets",
      "describe_toolset",
      "call_tool"
    ],
    "start_here": [
      "UeremcpCore.UeremcpReferenceToolset.GetStarted",
      "UeremcpCore.UeremcpReferenceToolset.ResolveIntent"
    ],
    "static": [
      "docs/guide/tool-selection-policy.md",
      "docs/guide/tool-selection-contract.json",
      "docs/guide/capability-reference.md",
      "docs/CAPABILITY_CATALOG.md",
      "docs/TOOL_ROUTER.md"
    ],
    "invocation_shape": "Prefer ResolveIntent first. Then call_tool(toolset_name, tool_name, arguments={ requestJson: <ADR-0003 envelope string> }) except Ping (no args)"
  },
  "required_description_cues": [
    "UEREMCP",
    "goal-level",
    "action=",
    "request envelope",
    "status"
  ],
  "mutation_markers": [
    "mutates",
    "destructive",
    "dry_run",
    "create",
    "replace",
    "write",
    "save"
  ],
  "validation_markers": [
    "validate",
    "re-read",
    "reread",
    "compiled",
    "*_validated",
    "failed_validation"
  ],
  "idempotency_markers": [
    "idempotency_key",
    "expected_revision",
    "revision"
  ],
