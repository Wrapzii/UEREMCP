              "properties": {
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            }
          }
        },
        "required": [
          "nodes"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "type": "object",
              "title": "/Script/MovieScene.MovieSceneSection",
              "properties": {
                "refPath": {
                  "type": "string",
                  "description": "The reference stored as a soft path string."
