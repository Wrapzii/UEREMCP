          }
        },
        "required": [
          "searchPath"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "type": "object",
              "title": "Class@/Script/CoreUObject.Object",
              "properties": {
                "refPath": {
                  "type": "string",
                  "description": "The reference stored as a soft path string."
                }
              },
              "required": [
                "refPath"
              ]
            },
            "description": "List of ViewModel classes."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "List Available Conversion functions for a WidgetBlueprint that bind a Source Property to a Destination Property",
      "name": "MVVMToolset.MVVMToolset.ListConversionFunctions",
      "inputSchema": {
        "type": "object",
        "properties": {
          "widgetBlueprint": {
            "type": "object",
            "title": "/Script/UMGEditor.WidgetBlueprint",
            "description": "WidgetBlueprint to use",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          }
        },
        "required": [
          "widgetBlueprint"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "title": "MVVMViewConversionFunctionDescription",
              "type": "object",
              "properties": {
                "conversionFunction": {
                  "type": "object",
                  "title": "/Script/CoreUObject.Function",
                  "description": "If the conversion function is a UFunction, this value will be set",
                  "properties": {
                    "refPath": {
                      "type": "string",
                      "description": "The reference stored as a soft path string."
                    }
                  },
                  "required": [
                    "refPath"
                  ]
                },
                "conversionNode": {
                  "type": "object",
                  "title": "Class@/Script/BlueprintGraph.K2Node",
                  "description": "If the conversion function is a UK2Node, this value will be set",
                  "properties": {
                    "refPath": {
                      "type": "string",
                      "description": "The reference stored as a soft path string."
                    }
                  },
                  "required": [
                    "refPath"
                  ]
                }
              },
              "required": [
                "conversionFunction",
                "conversionNode"
              ]
            },
            "description": "the FMVVMViewConversionFunctionDescription for available conversion functions."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "Creates a new ViewModel asset",
      "name": "MVVMToolset.MVVMToolset.CreateViewModel",
      "inputSchema": {
        "type": "object",
        "properties": {
          "viewModelName": {
            "type": "string",
            "description": "Desired ViewModel asset name."
          },
          "packagePath": {
            "type": "string",
            "description": "Target path in which the asset should reside"
          },
          "parentClass": {
            "type": "object",
            "title": "Class@/Script/CoreUObject.Object",
            "description": "Class of which the ViewModel should derive. Must derive UMVVMViewModelBase",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          }
        },
        "required": [
          "viewModelName",
          "packagePath",
          "parentClass"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "object",
            "title": "/Script/Engine.Blueprint",
            "description": "newly created ViewModel blueprint.",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "Creates a View Binding from the SourceProperty to the Destination property.\nIf there is a type mismatch, an existing conversion function will try to be used.",
      "name": "MVVMToolset.MVVMToolset.CreateViewBinding",
      "inputSchema": {
        "type": "object",
        "properties": {
          "widgetBlueprint": {
            "type": "object",
            "title": "/Script/UMGEditor.WidgetBlueprint",
            "description": "WidgetBlueprint to use",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          },
          "sourceContext": {
            "type": "object",
            "title": "/Script/CoreUObject.Object",
            "description": "Source object that contains the source property. Can be the following: - UWidget: source property is from a widget in the widget blueprint's widgettree - UClass: source property is from a widget blueprint's ViewModel - Null: source property is from the widget blueprint",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          },
          "sourcePropertyPath": {
            "type": "string",
            "description": "Property to read data from. Contains a dot '.' separated path to the field (path.subfield)"
          },
          "destinationContext": {
            "type": "object",
            "title": "/Script/CoreUObject.Object",
            "description": "Destination object that contains the destination property. Can be the following: - UWidget: destination property is from a widget in the widget blueprint's widgettree - UClass: destination property is from a widget blueprint's ViewModel - Null: destination property is from the widget blueprint",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          },
          "destinationPropertyPath": {
            "type": "string",
            "description": "Property to write data to. Contains a dot '.' separated path to the field (path.subfield)"
          },
          "conversionName": {
            "type": "string",
            "description": "Optional parameter, name of a conversion function to use if needed. If none is provided, this will be inferred."
          }
        },
        "required": [
          "widgetBlueprint",
          "sourceContext",
          "sourcePropertyPath",
          "destinationContext",
          "destinationPropertyPath",
          "conversionName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "string",
            "description": "Valid FGuid if the binding was created",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "Adds a ViewModel to the WidgetBlueprint",
