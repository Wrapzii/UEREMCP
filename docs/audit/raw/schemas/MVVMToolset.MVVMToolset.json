    {
      "description": "List all view bindings on the WidgetBlueprint",
      "name": "MVVMToolset.MVVMToolset.ListWidgetViewBindings",
      "inputSchema": {
        "type": "object",
        "properties": {
          "widgetBlueprint": {
            "type": "object",
            "title": "/Script/UMGEditor.WidgetBlueprint",
            "description": "WidgetBlueprint to use",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          }
        },
        "required": [
          "widgetBlueprint"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "array",
            "items": {
              "title": "MVVMBlueprintViewBinding",
              "type": "object",
              "properties": {
                "sourcePath": {
                  "title": "MVVMBlueprintPropertyPath",
                  "type": "object",
                  "properties": {
                    "paths": {
                      "type": "array",
                      "items": {
                        "title": "MVVMBlueprintFieldPath",
                        "type": "object",
                        "properties": {
                          "bindingReference": {
                            "title": "MemberReference",
                            "description": "Reference to property for this binding.",
                            "type": "object",
                            "properties": {
                              "memberParent": {
                                "type": "object",
                                "title": "/Script/CoreUObject.Object",
                                "description": "Most often the Class that this member is defined in. Could be a UPackage\nif it is a native delegate signature function (declared globally). Should\nbe NULL if bSelfContext is true.",
                                "properties": {
                                  "refPath": {
                                    "type": "string",
                                    "description": "The reference stored as a soft path string."
                                  }
                                },
                                "required": [
                                  "refPath"
                                ]
                              },
                              "memberScope": {
                                "type": "string"
                              },
                              "memberName": {
                                "type": "string",
                                "description": "Name of variable"
                              },
                              "memberGuid": {
                                "type": "string",
                                "description": "The Guid of the variable",
                                "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
                              },
                              "bSelfContext": {
                                "type": "boolean",
                                "description": "Whether or not this should be a \"self\" context"
                              },
                              "bWasDeprecated": {
                                "type": "boolean",
                                "description": "Whether or not this property has been deprecated"
                              }
                            },
                            "required": [
                              "memberParent",
                              "memberScope",
                              "memberName",
                              "memberGuid",
                              "bSelfContext",
                              "bWasDeprecated"
                            ]
                          },
                          "bindingKind": {
                            "type": "string",
                            "title": "EBindingKind",
                            "enum": [
                              "Function",
                              "Property"
                            ],
                            "description": "If we are referencing a UFunction or FProperty"
                          }
                        },
                        "required": [
                          "bindingReference",
                          "bindingKind"
                        ]
                      },
                      "description": "Reference to property for this binding."
                    },
                    "widgetName": {
                      "type": "string"
                    },
                    "contextId": {
                      "type": "string",
                      "description": "Globally unique identifier in 8-4-4-4-12 hyphenated form, e.g. \"E05FCC13-4D37-9D7A-E238-83859F29AD74\".",
                      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
                    },
                    "source": {
                      "type": "string",
                      "title": "EMVVMBlueprintFieldPathSource",
                      "enum": [
                        "None",
                        "Widget",
                        "ViewModel",
                        "SelfContext"
                      ]
                    },
                    "bIsComponent": {
                      "type": "boolean",
                      "description": "True if this property path is for a UI component. This affects how some fields in the path are filtered out."
                    },
                    "bDeprecatedSource": {
                      "type": "boolean",
                      "description": "Is the deprecation source done."
                    }
                  },
                  "required": [
                    "paths",
                    "widgetName",
                    "contextId",
                    "source",
                    "bIsComponent",
                    "bDeprecatedSource"
                  ]
                },
                "destinationPath": {
                  "title": "MVVMBlueprintPropertyPath",
                  "type": "object",
                  "properties": {
                    "paths": {
                      "type": "array",
                      "items": {
                        "title": "MVVMBlueprintFieldPath",
                        "type": "object",
                        "properties": {
                          "bindingReference": {
                            "title": "MemberReference",
                            "description": "Reference to property for this binding.",
                            "type": "object",
                            "properties": {
                              "memberParent": {
                                "type": "object",
                                "title": "/Script/CoreUObject.Object",
                                "description": "Most often the Class that this member is defined in. Could be a UPackage\nif it is a native delegate signature function (declared globally). Should\nbe NULL if bSelfContext is true.",
                                "properties": {
                                  "refPath": {
                                    "type": "string",
                                    "description": "The reference stored as a soft path string."
                                  }
                                },
                                "required": [
                                  "refPath"
                                ]
                              },
                              "memberScope": {
                                "type": "string"
                              },
                              "memberName": {
                                "type": "string",
                                "description": "Name of variable"
                              },
                              "memberGuid": {
                                "type": "string",
                                "description": "The Guid of the variable",
                                "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
                              },
                              "bSelfContext": {
                                "type": "boolean",
                                "description": "Whether or not this should be a \"self\" context"
                              },
                              "bWasDeprecated": {
                                "type": "boolean",
                                "description": "Whether or not this property has been deprecated"
                              }
                            },
                            "required": [
                              "memberParent",
                              "memberScope",
                              "memberName",
                              "memberGuid",
                              "bSelfContext",
                              "bWasDeprecated"
                            ]
                          },
                          "bindingKind": {
                            "type": "string",
                            "title": "EBindingKind",
                            "enum": [
                              "Function",
                              "Property"
                            ],
                            "description": "If we are referencing a UFunction or FProperty"
                          }
                        },
                        "required": [
                          "bindingReference",
                          "bindingKind"
                        ]
                      },
                      "description": "Reference to property for this binding."
                    },
                    "widgetName": {
                      "type": "string"
                    },
                    "contextId": {
                      "type": "string",
                      "description": "Globally unique identifier in 8-4-4-4-12 hyphenated form, e.g. \"E05FCC13-4D37-9D7A-E238-83859F29AD74\".",
                      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
                    },
                    "source": {
                      "type": "string",
                      "title": "EMVVMBlueprintFieldPathSource",
                      "enum": [
                        "None",
                        "Widget",
                        "ViewModel",
                        "SelfContext"
                      ]
                    },
                    "bIsComponent": {
                      "type": "boolean",
                      "description": "True if this property path is for a UI component. This affects how some fields in the path are filtered out."
                    },
                    "bDeprecatedSource": {
                      "type": "boolean",
                      "description": "Is the deprecation source done."
                    }
                  },
                  "required": [
                    "paths",
                    "widgetName",
                    "contextId",
                    "source",
                    "bIsComponent",
                    "bDeprecatedSource"
                  ]
                },
                "bindingType": {
                  "type": "string",
                  "title": "EMVVMBindingMode",
                  "enum": [
                    "OneTimeToDestination",
                    "OneWayToDestination",
                    "TwoWay",
                    "OneTimeToSource",
                    "OneWayToSource"
                  ]
                },
                "bOverrideExecutionMode": {
                  "type": "boolean"
                },
                "overrideExecutionMode": {
                  "type": "string",
                  "title": "EMVVMExecutionMode",
                  "enum": [
                    "Immediate",
                    "Delayed",
                    "Tick",
                    "DelayedWhenSharedElseImmediate"
                  ]
                },
                "conversion": {
                  "title": "MVVMBlueprintViewConversionPath",
                  "type": "object",
                  "properties": {
                    "destinationToSourceConversion": {
                      "type": "object",
                      "title": "/Script/ModelViewViewModelBlueprint.MVVMBlueprintViewConversionFunction",
                      "description": "The graph that contains the conversion function when converting the value from the destination to the source.\nWhen the function doesn't need a wrapper.",
                      "properties": {
                        "refPath": {
                          "type": "string",
                          "description": "The reference stored as a soft path string."
                        }
                      },
                      "required": [
                        "refPath"
                      ]
                    },
                    "sourceToDestinationConversion": {
                      "type": "object",
                      "title": "/Script/ModelViewViewModelBlueprint.MVVMBlueprintViewConversionFunction",
                      "description": "The graph that contains the conversion function when converting the value from the source to the destination.\nWhen the function doesn't need a wrapper.",
                      "properties": {
                        "refPath": {
                          "type": "string",
                          "description": "The reference stored as a soft path string."
                        }
                      },
                      "required": [
                        "refPath"
                      ]
                    }
                  },
                  "required": [
                    "destinationToSourceConversion",
                    "sourceToDestinationConversion"
                  ]
                },
                "bindingId": {
                  "type": "string",
                  "description": "The unique ID of this binding.",
                  "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
                },
                "bEnabled": {
                  "type": "boolean",
                  "description": "Whether the binding is enabled or disabled by default. The instance may enable the binding at runtime."
                },
                "bCompile": {
                  "type": "boolean",
                  "description": "The binding is visible in the editor, but is not compiled and cannot be used at runtime."
                }
              },
              "required": [
                "sourcePath",
                "destinationPath",
                "bindingType",
                "bOverrideExecutionMode",
                "overrideExecutionMode",
                "conversion",
                "bindingId",
                "bEnabled",
                "bCompile"
              ]
            },
            "description": "List of FMVVMBlueprintViewBinding that describe each available view binding."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "List all ViewModel under the search path",
      "name": "MVVMToolset.MVVMToolset.ListViewModels",
      "inputSchema": {
        "type": "object",
        "properties": {
          "searchPath": {
            "type": "string",
