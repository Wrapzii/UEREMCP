            "description": "ViewModel class to use.",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          }
        },
        "required": [
          "widgetBlueprint",
          "viewModelClass"
        ]
      }
    },
    {
      "description": "Add a property to an existing ViewModel",
      "name": "MVVMToolset.MVVMToolset.AddViewModelProperty",
      "inputSchema": {
        "type": "object",
        "properties": {
          "viewModel": {
            "type": "object",
            "title": "/Script/Engine.Blueprint",
            "description": "ViewModel asset to use.",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          },
          "propertyName": {
            "type": "string",
            "description": "Desired name of the new property"
          },
          "propertyType": {
            "type": "string",
            "description": "Desired type of the new property. Corresponds with PinType"
          },
          "defaultValue": {
            "type": "string",
            "description": "If a default property is desired, string representation of the value"
          }
        },
        "required": [
          "viewModel",
          "propertyName",
          "propertyType",
          "defaultValue"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "boolean",
            "description": "True if property was succesfully added."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    }
  ]
}
