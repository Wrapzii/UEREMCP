{
  "name": "MVVMToolset.MVVMToolset",
  "version": "1.0",
  "description": "MVVMToolset",
  "tools": [
    {
      "description": "Removes View Binding on the WidgetBlueprint",
      "name": "MVVMToolset.MVVMToolset.RemoveWidgetViewBinding",
      "inputSchema": {
        "type": "object",
        "properties": {
          "widgetBlueprint": {
            "type": "object",
            "title": "/Script/UMGEditor.WidgetBlueprint",
            "description": "WidgetBlueprint to use",
            "properties": {
              "refPath": {
                "type": "string",
                "description": "The reference stored as a soft path string."
              }
            },
            "required": [
              "refPath"
            ]
          },
          "bindingId": {
            "type": "string",
            "description": "Globally unique identifier in 8-4-4-4-12 hyphenated form, e.g. \"E05FCC13-4D37-9D7A-E238-83859F29AD74\".",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          }
        },
        "required": [
          "widgetBlueprint",
          "bindingId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "boolean",
            "description": "True if binding was removed."
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
