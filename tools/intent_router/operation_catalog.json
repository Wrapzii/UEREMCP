{
  "catalog_version": "1.0.0",
  "as_of": "2026-07-30",
  "owner": "WS-03",
  "notes": [
    "Enrichment overlay for ResolveIntent. Candidates still come only from the live registry/snapshot.",
    "depends_on_actions drive ordering; cycles are a CI failure.",
    "Visual capture prefers UeremcpValidation when present; otherwise RECapture remains valid."
  ],
  "dependencies": [
    {
      "action": "build_environment",
      "depends_on_actions": [],
      "why": "composite environment; prefer over staging primitives when building a full biome",
      "covers": [
        "create_landscape",
        "create_water_body",
        "scatter_foliage",
        "attach_weather"
      ],
      "covers_note": "One call that performs all four. If the intent enumerates the steps, the router must not silently substitute this composite: its failure modes and placeholder behaviour differ."
    },
    {
      "action": "create_water_body",
      "depends_on_actions": [
        "create_landscape"
      ],
      "why": "river usually conforms to terrain"
    },
    {
      "action": "scatter_foliage",
      "depends_on_actions": [
        "create_landscape",
        "create_water_body"
      ],
      "why": "bank forest needs terrain + river exclusion corridor"
    },
    {
      "action": "attach_weather",
      "depends_on_actions": [
        "create_landscape"
      ],
      "why": "weather follows after a world exists"
    },
    {
      "action": "place_structures",
      "depends_on_actions": [
        "create_landscape"
      ],
      "why": "structures sit on terrain / along river"
    },
    {
      "action": "capture_world_frames",
      "depends_on_actions": [
        "build_environment",
        "create_landscape"
      ],
      "why": "world capture after environment exists"
    },
    {
      "action": "create_niagara_effect",
      "depends_on_actions": [
        "create_vfx_material"
      ],
      "why": "effects bind materials; create materials first when both are needed"
    },
    {
      "action": "capture_effect_frames",
      "depends_on_actions": [
        "create_niagara_effect",
        "inspect_system"
      ],
      "why": "capture verifies an existing system; author or inspect first"
    },
    {
      "action": "create_spell",
      "depends_on_actions": [
        "create_niagara_effect",
        "create_vfx_material"
      ],
      "why": "spell preflight often references VFX assets that should exist"
    },
    {
      "action": "instantiate_template",
      "depends_on_actions": [
        "search_templates"
      ],
      "why": "prefer search to pick template_id before instantiate when unknown"
    },
    {
      "action": "submit_graph",
      "depends_on_actions": [
        "read_graph"
      ],
      "why": "replace requires expected_revision from a prior read"
    },
    {
      "action": "get_job_result",
      "depends_on_actions": [],
      "why": "poll after a prior partially_completed response"
    },
    {
      "action": "create_master_material",
      "depends_on_actions": [
        "create_procedural_texture"
      ],
      "why": "a master samples the textures it wires; generate them first"
    },
    {
      "action": "submit_mesh_ops",
      "depends_on_actions": [
        "create_master_material"
      ],
      "why": "a mesh needs a surface material before it is useful downstream"
    },
    {
      "action": "editor_toolset.toolsets.static_mesh.StaticMeshTools.import_file",
      "depends_on_actions": [],
      "why": "import is a source of geometry, not a consumer -- it runs before anything that places a mesh, and is the alternative to SubmitMeshOps when the result must match a reference rather than merely read as a tree"
    }
  ],
