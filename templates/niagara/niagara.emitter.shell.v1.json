{
  "template_id": "niagara.emitter.shell.v1",
  "domain": "niagara",
  "category": "emitter_archetype",
  "version": 1,
  "description": "Flame shell / mesh spiral emitter archetype.",
  "purpose": "Outer flame body; maps to Firebolt Spiral1 emitter role.",
  "authored_by": "human",
  "engine_compatibility": {
    "min_version": "5.8.0",
    "verified_on": ["5.8.0"]
  },
  "inputs": {
    "type": "object",
    "properties": {
      "color": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
      "scale": { "type": "number", "minimum": 0 }
    },
    "required": ["color", "scale"]
  },
  "required_components": ["shell_emitter", "mesh_or_sprite_renderer"],
  "supported_modifiers": ["tighten_spiral", "widen_shell"],
  "construction_plan": [
    {
      "id": "emitter",
      "action": "create_niagara_effect",
      "specification": {
        "effect_type": "emitter_archetype",
        "archetype_role": "shell",
        "emitter_template_path": "/Niagara/DefaultAssets/Templates/Emitters/UpwardMeshBurst/UpwardMeshBurstEmitter",
        "parameters": {
          "primary_color": [1.0, 0.35, 0.05, 1.0],
          "scale": 1.0
        }
      }
    }
  ],
  "validation_rules": [
    {
      "rule_id": "shell_emitter_present",
      "check": "emitter_count >= 1",
      "severity": "error",
      "message": "Shell archetype must add one enabled emitter."
    }
  ],
  "typical_ranges": {
    "scale": { "min": 0.5, "max": 2.5, "typical": 1.0 }
  },
  "search_terms": ["shell", "spiral", "flame", "mesh burst", "projectile"]
}
